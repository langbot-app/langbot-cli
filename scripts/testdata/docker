#!/bin/sh
case "$*" in
    'context inspect --format {{.Name}}	{{.Endpoints.docker.Host}}') printf 'default\tunix:///var/run/docker.sock\n' ;;
    '--context default compose version --short') printf '2.40.0\n' ;;
    '--context default info --format {{.ServerVersion}}') printf '29.0.0\n' ;;
    *) exit 1 ;;
esac
